# Copy to .env and fill in real values yourself. Never commit .env.
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_hex(32)); print(secrets.token_hex(24))"

APP_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

PORT=8000
GUNICORN_BIND=127.0.0.1:8000
PUBLIC_URL=https://amiriinsuranceagency.com
ALLOWED_HOSTS=amiriinsuranceagency.com,www.amiriinsuranceagency.com
BEHIND_PROXY=1
FORWARDED_ALLOW_IPS=127.0.0.1,::1
SESSION_COOKIE_SECURE=1
SESSION_HOURS=12
SESSION_IDLE_MINUTES=60

# Production Postgres on the VPS is port 5432. Local Docker Compose uses 5433.
# Managed Postgres often needs DATABASE_SSL=1.
POSTGRES_PASSWORD=replace-with-a-long-random-string
DATABASE_URL=postgresql://amiri:replace-with-a-long-random-string@127.0.0.1:5432/amiri
DATABASE_SSL=0

BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@amiriinsuranceagency.com
BREVO_SENDER_NAME=Amiri Insurance
BREVO_NOTIFY_EMAIL=info@amiriinsuranceagency.com
BREVO_LIST_ID=

CRON_TOKEN=replace-with-a-random-token
HEALTH_TOKEN=

INVOICE_BANK=KCB Bank
INVOICE_ACCOUNT_NAME=AMIRI INSURANCE AGENCY
INVOICE_ACCOUNT_NUMBER=1272842827
